FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      turbulenceProperties;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

simulationType  LES;

LES
{
    LESModel            SpalartAllmarasSALSADDES;
    turbulence          on;
    printCoeffs         on;

    delta           DeltaOmegaTilde;
    DeltaOmegaTildeCoeffs
    {}

    SpalartAllmarasSALSADDESCoeffs
    {
        shielding     ZDES2020;
        usefP2        true;
        useSigma      false;

        // SALSA settings
        rhoInf            0.957837;     // required for useRmod = true
        useRmod           true;
        useSmod           true;
    }
}

